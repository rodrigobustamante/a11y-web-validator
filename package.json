{
  "name": "a11y-web-validator",
  "version": "0.1.0",
  "private": true,
  "description": "A11yScan - Web Accessibility Validator for WCAG 2.1/2.2 Standards",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "type-check": "turbo run type-check",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "turbo": "^2.11.10",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.15.0",
  "pnpm": {
    "overrides": {
      "minimatch@9": "^9.0.7",
      "postcss@8.4.31": "^8.5.23",
      "refractor>prismjs": "^1.30.0",
      "postcss-selector-parser@7": "^7.1.6"
    }
  }
}
